# BACKEND_DOMAIN 的 DNS A 記錄指到這台 VPS 後，Caddy 會自動申請並續期憑證。
# 會自帶 X-Forwarded-For，後端 TRUSTED_PROXY_IPS=private 即可辨識真實訪客 IP。
{$BACKEND_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8000
}

# 同一台 VPS 上其他專案的站台（例如 Twitch 後端）放在 VPS 的
# deploy/vps/sites/*.caddy，不進這個 repo。目錄是空的也合法。
import /etc/caddy/sites/*.caddy
