# 複製成 deploy/vps/.env 後填值（.env 已在 .gitignore，不會進版控）。
# 在 VPS 上：cp .env.example .env && chmod 600 .env
#
# Zeabur 在 2026-10-14 有外部入侵事件，下面的密碼與 key 一律產生新的，
# 不要沿用 Zeabur 上的舊值。

# === 資料庫（compose 會用這三個組出 DATABASE_URL）===
POSTGRES_USER=stockwise
POSTGRES_DB=stockwise
POSTGRES_PASSWORD=       # openssl rand -hex 24

# === 網域（DNS A 記錄指到這台 VPS）===
BACKEND_DOMAIN=          # 例：api.example.com

# === 排程 ===
# 演練期間保持 external；正式切換那一刻才改 internal（見 MIGRATION.md 步驟 6）
SCHEDULER_MODE=external

# === 應用程式（對照 Zeabur 後端服務的環境變數逐一填入）===
GEMINI_API_KEY=
GEMINI_READ_TIMEOUT_SECONDS=300
GEMINI_MAX_RETRIES=2
FINMIND_TOKEN=
FINNHUB_TOKEN=
OPENROUTER_API_KEY=
JOB_TOKEN=               # openssl rand -hex 32；換了要同步更新 GitHub secret
ALERT_WEBHOOK_URL=
CORS_ORIGINS=            # 前端網址，例：https://your-app.vercel.app
TRUSTED_PROXY_IPS=private
